# Copy this file to .env and fill in real values. Never commit .env.

# Razorpay TEST-MODE keys only (Settings -> API Keys -> Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key (used by all three agents)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SQLite file path (relative to backend/)
DATABASE_URL=sqlite:///./frontage.db

# Default mandate used to seed the demo (in paise, i.e. INR * 100)
DEFAULT_MANDATE_SPEND_CEILING_PAISE=150000
