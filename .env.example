# Copy this file to .env and fill in real values. Never commit .env.

# Razorpay TEST-MODE keys only (Settings -> API Keys -> Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Groq API key (free tier, console.groq.com) — used by the Fix and Buyer agents
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SQLite file path (relative to backend/)
DATABASE_URL=sqlite:///./frontage.db

# Default mandate used to seed the demo (in paise, i.e. INR * 100)
DEFAULT_MANDATE_SPEND_CEILING_PAISE=150000
