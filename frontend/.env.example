# Copy this file to .env.local and fill in real values for production. Never commit
# .env/.env.local. Local dev needs nothing here -- api.js falls back to
# http://127.0.0.1:8000 when this is unset.

# The deployed backend's real origin, no trailing slash, e.g.:
VITE_API_BASE_URL=https://frontage-api.onrender.com
